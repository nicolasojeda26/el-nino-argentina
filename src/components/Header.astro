---
import { nav, site } from "../data/content";
import { buildStatus, formatAnomaly, getOni } from "../data/oni";
import Sun from "./Sun.astro";
import EnsoScale from "./EnsoScale.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const s = buildStatus(await getOni());
---

<header class="site-header">
  <a href="/pronostico/" class="ticker" aria-label={`Estado actual: ${s.state}, ONI ${formatAnomaly(s.latest.anomaly)} °C. Ver pronóstico`}>
    <div class="container">
      <span class="ticker-live"><span class="dot"></span> En vivo</span>
      <span class="ticker-value">
        ONI {s.latest.season} {s.latest.year} · {formatAnomaly(s.latest.anomaly)}°C
      </span>
      <span class="ticker-state">
        {s.state}
        {s.state !== "Neutral" ? ` · ${s.intensity}` : ""}
      </span>
      <span class="ticker-scale">
        <EnsoScale value={s.latest.anomaly} compact />
      </span>
    </div>
  </a>

  <div class="container inner">
    <a href="/" class="brand" aria-label={`${site.name} — inicio`}>
      <Sun size={22} />
      <span>
        El Niño Argentina
        <small>Monitoreo ENSO</small>
      </span>
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav">☰</button>
    <nav class="nav" id="nav" aria-label="Principal">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menuToggle");
  const navEl = document.getElementById("nav");

  const setMenu = (open: boolean) => {
    if (!toggle || !navEl) return;
    navEl.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    toggle.textContent = open ? "✕" : "☰";
  };

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = navEl?.classList.contains("open") ?? false;
    setMenu(!isOpen);
  });

  document.addEventListener("click", (e) => {
    if (!navEl?.classList.contains("open")) return;
    const target = e.target as Node | null;
    if (target && !navEl.contains(target) && target !== toggle) {
      setMenu(false);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && navEl?.classList.contains("open")) {
      setMenu(false);
      toggle?.focus();
    }
  });
</script>
