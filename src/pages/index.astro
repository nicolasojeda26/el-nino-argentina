---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import OniChart from "../components/OniChart.astro";
import EnsoScale from "../components/EnsoScale.astro";
import ArgentinaMap from "../components/ArgentinaMap.astro";
import DataTools from "../components/DataTools.astro";
import AdSlot from "../components/AdSlot.astro";
import Icon from "../components/Icon.astro";
import Sun from "../components/Sun.astro";
import { getOni, buildStatus, formatAnomaly, getNextNoaaRelease } from "../data/oni";
import { regions, site, outlook } from "../data/content";

const points = await getOni();
const s = buildStatus(points);
const nextRelease = getNextNoaaRelease();

const stateClass = s.state === "El Niño" ? "warm" : s.state === "La Niña" ? "cool" : "neutral";
const trendIcon = s.trend === "subiendo" ? "↑" : s.trend === "bajando" ? "↓" : "→";
const peak = points.reduce((a, b) => (b.anomaly > a.anomaly ? b : a));

const o = outlook[s.state];
const notes = (await getCollection("noticias", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat("es-AR", { day: "numeric", month: "long", year: "numeric" }).format(d);
const built = fmtDate(new Date());

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Índice ONI (Oceanic Niño Index) y estado ENSO",
  description:
    "Serie histórica del índice ONI de NOAA y estado actual del fenómeno de El Niño / La Niña.",
  url: new URL("/", Astro.site ?? site.url).href,
  creator: { "@type": "Organization", name: "NOAA Climate Prediction Center" },
  temporalCoverage: "1950/..",
  variableMeasured: "Oceanic Niño Index",
  distribution: {
    "@type": "DataDownload",
    encodingFormat: "text/csv",
    contentUrl: new URL("/datos/oni.csv", Astro.site ?? site.url).href,
  },
};
---

<Layout title="El Niño en Argentina: estado, pronóstico e impactos" jsonLd={jsonLd}>
  <section class="hero">
    <span class="hero-sun" aria-hidden="true"><Sun size={520} rays={24} /></span>
    <div class="container">
      <p class="eyebrow">Monitoreo ENSO · datos NOAA</p>
      <h1>
        El Niño llega a Argentina: seguí el fenómeno<br />
        <span class="hl">trimestre a trimestre</span>
      </h1>
      <p class="lead">
        Estado del Pacífico, intensidad, pronóstico y qué significa para el clima, el campo
        y los ríos de cada región del país.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/pronostico/">Ver pronóstico →</a>
        <a class="btn btn-ghost" href="#mapa">Impactos por región</a>
      </div>
    </div>
  </section>

  <section class="band band-rays">
    <div class="container">
      <div class="panel">
        <div class="panel-head">
          <span class="mono" style="color:var(--sol)">
            ● Estado actual · {s.state}
          </span>
          <span class="mono">Actualizado {built}</span>
        </div>

        <div class="panel-main">
          <div class={`panel-value ${stateClass}`}>
            {formatAnomaly(s.latest.anomaly)}
            <small>°C &nbsp;ONI {s.latest.season} {s.latest.year}</small>
          </div>
          <div class="panel-state">
            <div class="state">{s.state}</div>
            <div class="intensity">
              {s.state === "Neutral" ? "sin fase activa" : `intensidad ${s.intensity.toLowerCase()}`}
            </div>
          </div>
        </div>

        <EnsoScale
          value={s.latest.anomaly}
          caption={`El ONI actual (${formatAnomaly(s.latest.anomaly)} °C) se ubica en zona de ${s.state}.`}
        />

        <dl class="panel-stats">
          <div>
            <dt>Tendencia</dt>
            <dd>{trendIcon} {formatAnomaly(s.delta)}°</dd>
          </div>
          <div>
            <dt>Hace 12 meses</dt>
            <dd>{formatAnomaly(s.yearAgo.anomaly)}° <span class="mono">{s.yearAgo.season}</span></dd>
          </div>
          <div>
            <dt>Récord histórico</dt>
            <dd>{formatAnomaly(peak.anomaly)}° <span class="mono">{peak.season} {peak.year}</span></dd>
          </div>
          <div>
            <dt>Próximo boletín NOAA</dt>
            <dd class="small">
              {nextRelease.shortLabel} <span class="mono">({nextRelease.daysLeft} d)</span>
            </dd>
          </div>
        </dl>
      </div>

      <div class="sub-block">
        <p class="eyebrow">Serie histórica</p>
        <h2>El índice ONI desde 2018</h2>
        <p class="lead" style="margin-bottom:26px;">
          Cada barra es un trimestre móvil. Por encima de +0,5 °C hay condiciones de El Niño;
          por debajo de −0,5 °C, de La Niña.
        </p>
        <OniChart points={points} count={32} />
        <DataTools />
      </div>
    </div>
  </section>

  <AdSlot label="Publicidad" slot="home-top" />

  <section class="section container">
    <p class="eyebrow">El ciclo ENSO</p>
    <h2>El Niño vs. La Niña</h2>
    <div class="grid grid-2" style="margin-top:30px;">
      <div class="card" data-phase="nino">
        <div class="icon"><Icon name="flame" size={30} /></div>
        <h3>El Niño (fase cálida)</h3>
        <p>
          Aguas del Pacífico ecuatorial más cálidas de lo normal. En Argentina suele
          traducirse en <strong>más lluvias</strong> en el Litoral, el NEA y la región pampeana.
        </p>
        <a class="more" href="/el-nino/">Qué es El Niño →</a>
      </div>
      <div class="card" data-phase="nina">
        <div class="icon"><Icon name="snow" size={30} /></div>
        <h3>La Niña (fase fría)</h3>
        <p>
          Aguas más frías de lo normal. Históricamente asociada a <strong>sequías</strong> y
          déficit de lluvias en el centro del país, con impacto directo en la producción agrícola.
        </p>
        <a class="more" href="/la-nina/">Qué es La Niña →</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <p class="eyebrow">Próximos meses</p>
    <h2>{o.title}</h2>
    <div class="callout" style="margin-top:26px;">
      <ul style="color:var(--text-soft);padding-left:1.1em;margin:0;">
        {o.items.map((item) => <li style="margin-bottom:10px;">{item}</li>)}
      </ul>
    </div>
    <div class="hero-cta">
      <a class="btn btn-ghost" href="/pronostico/">Pronóstico completo →</a>
    </div>
  </section>

  <section class="band" id="mapa">
    <div class="container">
      <p class="eyebrow">Territorio</p>
      <h2>El efecto no es igual en todo el país</h2>
      <p class="lead" style="margin-bottom:22px;">
        Explorá el mapa y elegí tu región para ver impactos, riesgos y recomendaciones.
      </p>
      <div class="chips" style="margin-top:0;margin-bottom:30px;">
        {
          regions.map((r) => (
            <a class="chip" data-region={r.slug} href={`/impactos/${r.slug}/`}>
              <span class="swatch" aria-hidden="true" />
              {r.name}
            </a>
          ))
        }
      </div>
      <ArgentinaMap />
    </div>
  </section>

  <section class="section container">
    <p class="eyebrow">Notas</p>
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;">
      <h2 style="margin-bottom:0;">Últimas notas</h2>
      <a class="more" href="/noticias/">Ver todas →</a>
    </div>
    <div class="grid grid-3" style="margin-top:30px;">
      {
        notes.map((post) => (
          <a class="card post-card" href={`/noticias/${post.id}/`}>
            <span class="tag">{post.data.tag}</span>
            <h3>{post.data.title}</h3>
            <p style="font-size:0.92rem;">{post.data.description}</p>
            <div class="post-meta">
              <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section container prose">
    <p class="eyebrow">Metodología</p>
    <h2>Cómo calculamos el estado</h2>
    <p>
      Usamos el <strong>ONI</strong> (Oceanic Niño Index) del Climate Prediction Center de
      NOAA, el indicador estándar para medir ENSO. El valor de cada trimestre es el promedio
      móvil de 3 meses de la anomalía de temperatura superficial del mar en la región Niño 3.4.
    </p>
    <div class="callout">
      <p>
        <strong>Actual:</strong> {s.latest.season} {s.latest.year} = {formatAnomaly(s.latest.anomaly)} °C.
        {s.state !== "Neutral"
          ? ` Condiciones de ${s.state} de intensidad ${s.intensity.toLowerCase()}.`
          : " Condiciones neutrales."}
      </p>
    </div>
    <p>
      El sitio se recalcula con los datos públicos de NOAA. Para pronósticos locales,
      consultá siempre el <a href="https://www.smn.gob.ar/" rel="noopener" target="_blank">Servicio Meteorológico Nacional</a>.
    </p>
  </section>
</Layout>
