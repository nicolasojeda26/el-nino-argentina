---
import { site } from "../data/content";

const embedCode = `<iframe src="${site.url}/widget/" width="100%" height="220" style="border:0;max-width:480px;border-radius:3px;" loading="lazy" title="Monitor El Niño Argentina"></iframe>`;
---

<div class="data-tools" data-tools-root>
  <div class="data-tools-actions">
    <a class="btn btn-ghost" href="/datos/oni.csv" download="oni-noaa-argentina.csv">
      ↓ Descargar serie ONI (.CSV)
    </a>
    <button
      type="button"
      class="btn btn-ghost"
      data-embed-toggle
      aria-expanded="false"
    >
      ⟨/⟩ Insertar monitor en tu web
    </button>
  </div>

  <div class="embed-panel" data-embed-panel hidden>
    <p style="font-size:0.88rem;margin-bottom:10px;">
      Copiá este código HTML para insertar el monitor ENSO actualizado automáticamente en tu portal, diario, blog o radio:
    </p>
    <div class="embed-code-row">
      <input
        type="text"
        readonly
        value={embedCode}
        class="embed-input"
        aria-label="Código HTML para insertar widget"
        data-embed-input
      />
      <button type="button" class="btn btn-primary" data-embed-copy>Copiar código</button>
    </div>
    <div class="embed-preview">
      <span class="mono" style="display:block;margin-bottom:8px;opacity:0.75;">Vista previa del widget:</span>
      <iframe
        src="/widget/"
        width="100%"
        height="210"
        style="border:1px solid var(--rule-ink);max-width:460px;border-radius:3px;display:block;"
        loading="lazy"
        title="Vista previa del Monitor El Niño Argentina"
      ></iframe>
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tools-root]")) {
    const toggleBtn = root.querySelector<HTMLButtonElement>("[data-embed-toggle]");
    const panel = root.querySelector<HTMLElement>("[data-embed-panel]");
    const copyBtn = root.querySelector<HTMLButtonElement>("[data-embed-copy]");
    const input = root.querySelector<HTMLInputElement>("[data-embed-input]");

    toggleBtn?.addEventListener("click", () => {
      if (!panel) return;
      const isHidden = panel.hasAttribute("hidden");
      if (isHidden) {
        panel.removeAttribute("hidden");
      } else {
        panel.setAttribute("hidden", "");
      }
      toggleBtn.setAttribute("aria-expanded", String(isHidden));
    });

    copyBtn?.addEventListener("click", async () => {
      if (!input) return;
      try {
        await navigator.clipboard.writeText(input.value);
        const prev = copyBtn.textContent;
        copyBtn.textContent = "¡Copiado!";
        setTimeout(() => {
          copyBtn.textContent = prev;
        }, 2000);
      } catch {
        input.select();
      }
    });
  }
</script>
