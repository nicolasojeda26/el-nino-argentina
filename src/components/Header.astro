---
import { nav, site } from "../data/content";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand" aria-label={`${site.name} — inicio`}>
      <span class="dot" aria-hidden="true">🌡️</span>
      <span>
        El Niño Argentina
        <small>Monitoreo ENSO</small>
      </span>
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false">☰</button>
    <nav class="nav" id="nav" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menuToggle");
  const navEl = document.getElementById("nav");
  toggle?.addEventListener("click", () => {
    const open = navEl?.classList.toggle("open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
