---
import type { OniPoint } from "../data/oni";
import { formatAnomaly, seasonLabel } from "../data/oni";

interface Props {
  points: OniPoint[];
  count?: number;
  height?: number;
}

const { points, count = 72, height = 320 } = Astro.props;
const data = points.slice(-count);

const W = 1000;
const H = height;
const padL = 52;
const padR = 18;
const padT = 34;
const padB = 36;
const plotW = W - padL - padR;
const plotH = H - padT - padB;

const maxAbs = Math.max(1, ...data.map((d) => Math.abs(d.anomaly)));
const scale = Math.ceil(maxAbs * 2) / 2;
const top = Math.ceil(scale);
const y0 = padT + plotH / 2;
const yScale = plotH / 2 / scale;

const n = data.length;
const stepW = plotW / n;
const barW = Math.min(Math.max(stepW - 2, 0.8), stepW);

const bars = data.map((d, i) => {
  const x = padL + i * stepW + (stepW - barW) / 2;
  const h = Math.max(Math.abs(d.anomaly) * yScale, 0.6);
  const y = d.anomaly >= 0 ? y0 - h : y0;
  return { x, y, h, warm: d.anomaly >= 0, d };
});

const tickStep = top >= 2 ? 1 : 0.5;
const ticks: number[] = [];
for (let v = -top; v <= top + 1e-9; v += tickStep) {
  ticks.push(Math.round((v + Number.EPSILON) * 2) / 2);
}

const djfIndices = data
  .map((d, i) => ({ d, i }))
  .filter(({ d }) => d.season === "DJF");
const labelEvery = Math.ceil(djfIndices.length / 12);
const yearLabels = djfIndices.filter((_, idx) => idx % labelEvery === 0);

const yFor = (v: number) => y0 - v * yScale;

const neutralTop = yFor(0.5);
const neutralBottom = yFor(-0.5);
const last = bars[bars.length - 1];
const monoFont = '"IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace';
---

<div class="chart-wrap">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`Serie de tiempo del índice ONI, últimos ${n} trimestres`}
    preserveAspectRatio="xMidYMid meet"
  >
    <rect
      x={padL}
      y={neutralTop}
      width={plotW}
      height={Math.max(neutralBottom - neutralTop, 1)}
      style="fill:rgba(234,242,249,0.05)"
    />

    {
      ticks.map((v) => (
        <g>
          <line
            x1={padL}
            x2={W - padR}
            y1={yFor(v)}
            y2={yFor(v)}
            stroke={v === 0 ? "rgba(234,242,249,0.38)" : "rgba(234,242,249,0.1)"}
            stroke-width={v === 0 ? 1.4 : 1}
            stroke-dasharray={v === 0 ? "0" : "3 6"}
          />
          <text
            x={padL - 10}
            y={yFor(v) + 4}
            text-anchor="end"
            fill="#7d94a8"
            font-size="12"
            font-family={monoFont}
          >
            {v > 0 ? `+${v}` : v}
          </text>
        </g>
      ))
    }

    {
      bars.map((b) => (
        <rect
          x={b.x}
          y={b.y}
          width={barW}
          height={b.h}
          rx="1"
          style={`fill:${b.warm ? "var(--nino)" : "var(--nina)"}`}
        >
          <title>{`${b.d.season} ${b.d.year} (${seasonLabel(b.d.season)}): ONI ${formatAnomaly(b.d.anomaly)}`}</title>
        </rect>
      ))
    }

    {
      last && (
        <g>
          <line
            x1={last.x + barW / 2}
            x2={last.x + barW / 2}
            y1={padT}
            y2={H - padB}
            stroke="var(--sol)"
            stroke-width="1"
            stroke-dasharray="2 4"
            opacity="0.6"
          />
          <circle cx={last.x + barW / 2} cy={last.y - 6} r="3.4" style="fill:var(--sol)" />
        </g>
      )
    }

    {
      yearLabels.map(({ d, i }) => (
        <text
          x={padL + i * stepW + barW / 2}
          y={H - 12}
          text-anchor="middle"
          fill="#7d94a8"
          font-size="12"
          font-family={monoFont}
        >
          {d.year}
        </text>
      ))
    }
  </svg>

  <div class="legend">
    <span><i style="background:var(--nino)"></i> El Niño · sobre +0,5°</span>
    <span><i style="background:var(--nina)"></i> La Niña · bajo −0,5°</span>
    <span><i style="background:var(--sol)"></i> Último dato publicado</span>
  </div>
</div>
