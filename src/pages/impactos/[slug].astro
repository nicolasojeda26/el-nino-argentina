---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import Icon from "../../components/Icon.astro";
import { provincesData, regions, site } from "../../data/content";

export function getStaticPaths() {
  return regions.map((region) => ({ params: { slug: region.slug }, props: { region } }));
}

const { region } = Astro.props;
const others = regions.filter((r) => r.slug !== region.slug);
const regionProvinces = provincesData.filter((p) => p.regionSlug === region.slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `El Niño en ${region.name}: impactos y qué esperar`,
  inLanguage: "es-AR",
  url: new URL(Astro.url.pathname, Astro.site ?? site.url).href,
  isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
  about: { "@type": "Place", name: region.name, description: region.provinces },
  publisher: { "@type": "Organization", name: site.name },
};
---

<Layout
  title={`El Niño en ${region.name}: impactos y qué esperar`}
  description={`Cómo afecta El Niño y La Niña a ${region.name} (${region.provinces}): lluvias, sequías, ríos, agro y recomendaciones.`}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Inicio", path: "/" },
    { name: "Impactos", path: "/impactos/" },
    { name: region.name, path: `/impactos/${region.slug}/` },
  ]}
>
  <div class="container breadcrumbs">
    <a href="/">Inicio</a> · <a href="/impactos/">Impactos</a> · {region.name}
  </div>

  <section class="section container">
    <div class="region-badge" data-region={region.slug}>
      <Icon name={region.iconName} size={30} />
    </div>
    <p class="eyebrow" style="margin-top:18px;">{region.provinces}</p>
    <h1>El Niño en {region.name}</h1>
    <p class="lead">{region.summary}</p>
  </section>

  <section class="section container prose">
    <p>{region.detail}</p>
  </section>

  <AdSlot label="Publicidad" slot={`impactos-${region.slug}`} />

  <section class="section container">
    <h2>El Niño vs. La Niña en {region.name}</h2>
    <div class="grid grid-2" style="margin-top:22px;">
      <div class="card" data-phase="nino">
        <div class="icon"><Icon name="flame" size={28} /></div>
        <h3>Con El Niño (fase cálida)</h3>
        <p style="font-size:0.94rem;">{region.summary}</p>
        <ul style="color:var(--text-soft);padding-left:1.2em;margin-bottom:0;">
          {region.points.map((p) => <li style="margin-bottom:8px;">{p}</li>)}
        </ul>
      </div>
      <div class="card" data-phase="nina">
        <div class="icon"><Icon name="snow" size={28} /></div>
        <h3>Con La Niña (fase fría)</h3>
        <p style="font-size:0.94rem;">{region.ninaSummary}</p>
        <ul style="color:var(--text-soft);padding-left:1.2em;margin-bottom:0;">
          {region.ninaPoints.map((p) => <li style="margin-bottom:8px;">{p}</li>)}
        </ul>
      </div>
    </div>

    <div class="callout" style="margin-top:28px;">
      <h3 style="margin-top:0;margin-bottom:10px;">Recomendaciones para la región</h3>
      <ul style="color:var(--text-soft);padding-left:1.2em;margin:0;">
        {region.recommendations.map((p) => <li style="margin-bottom:8px;">{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section container">
    <h2>Provincias en {region.name}</h2>
    <div class="grid grid-3" style="margin-top:20px;">
      {
        regionProvinces.map((p) => (
          <a class="card" href={`/impactos/provincia/${p.slug}/`}>
            <span class="tag">Exposición {p.exposure}</span>
            <h3>{p.name}</h3>
            <p style="font-size:0.88rem;">{p.sectors}</p>
            <span class="more">Ver ficha provincial →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <h2>Otras regiones</h2>
    <div class="grid grid-2" style="margin-top:20px;">
      {
        others.map((r) => (
          <a class="card" href={`/impactos/${r.slug}/`}>
            <div class="icon" data-region={r.slug}>
              <Icon name={r.iconName} size={28} />
            </div>
            <h3>{r.name}</h3>
            <p style="font-size:0.9rem;">{r.provinces}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
