---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import { faq, glossary } from "../data/content";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title="Preguntas frecuentes sobre El Niño"
  description="Respuestas claras sobre El Niño y La Niña: qué son, cómo se diferencian, qué es el ONI, si va a llover más y cuánto dura un evento."
  jsonLd={jsonLd}
>
  <div class="container breadcrumbs"><a href="/">Inicio</a> · Preguntas</div>

  <section class="section container">
    <p class="eyebrow">Ayuda</p>
    <h1>Preguntas frecuentes</h1>
    <p class="lead">Lo esencial sobre el fenómeno de El Niño y La Niña, sin tecnicismos.</p>

    <div style="margin-top:32px;">
      {
        faq.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <div class="answer">{f.a}</div>
          </details>
        ))
      }
    </div>
  </section>

  <AdSlot label="Publicidad" slot="faq" />

  <section class="section container">
    <h2>Glosario</h2>
    <div class="table-wrap" style="max-width:820px;margin-top:20px;">
      <table>
        <thead>
          <tr><th>Término</th><th>Significado</th></tr>
        </thead>
        <tbody>
          {
            glossary.map((g) => (
              <tr>
                <td><strong>{g.term}</strong></td>
                <td style="white-space:normal">{g.definition}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section container prose" id="acerca">
    <h2>Acerca del sitio</h2>
    <p>
      <strong>El Niño Argentina</strong> es un portal informativo independiente que reúne,
      en un solo lugar, el estado del fenómeno ENSO y sus implicancias para el país. Los
      datos de temperatura del mar provienen del Climate Prediction Center (CPC) de la NOAA,
      de acceso público.
    </p>
    <div class="callout">
      <p>
        <strong>Aviso legal:</strong> este sitio tiene fines exclusivamente informativos y no
        reemplaza los pronósticos ni las alertas de los organismos oficiales. Para decisiones
        agropecuarias, de seguridad o de gestión de riesgo, consultá siempre al
        <a href="https://www.smn.gob.ar/" rel="noopener" target="_blank">Servicio Meteorológico Nacional</a>.
      </p>
    </div>
    <h3>Metodología</h3>
    <p>
      El estado ENSO se deriva del índice ONI (promedio móvil de 3 meses de la anomalía de
      temperatura superficial del mar en Niño 3.4). Las referencias de impacto regional se
      basan en la literatura climática y los informes de organismos oficiales.
    </p>
  </section>
</Layout>
