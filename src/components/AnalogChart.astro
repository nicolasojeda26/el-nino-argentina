---
import type { OniPoint } from "../data/oni";
import { ANALOG_SEASONS, formatAnomaly, getAnalogSeries, seasonLabel } from "../data/oni";

interface Props {
  points: OniPoint[];
}

const { points } = Astro.props;
const series = getAnalogSeries(points);

const W = 1000;
const H = 320;
const padL = 56;
const padR = 26;
const padT = 30;
const padB = 38;
const plotW = W - padL - padR;
const plotH = H - padT - padB;
const maxScale = 3.0;
const y0 = padT + plotH / 2;
const yScale = plotH / 2 / maxScale;
const yFor = (v: number) => y0 - v * yScale;
const xFor = (i: number) => padL + (i / (ANALOG_SEASONS.length - 1)) * plotW;

const ticks = [-3, -2, -1, 0, 1, 2, 3];
const monoFont = '"IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace';

const neutralTop = yFor(0.5);
const neutralBottom = yFor(-0.5);

const builtSeries = series.map((s) => {
  const coords: { x: number; y: number; v: number; season: string; idx: number }[] = [];
  s.values.forEach((v, i) => {
    if (v !== null && Number.isFinite(v)) {
      coords.push({ x: xFor(i), y: yFor(v), v, season: ANALOG_SEASONS[i], idx: i });
    }
  });
  const d = coords.map((pt, idx) => `${idx === 0 ? "M" : "L"}${pt.x.toFixed(1)},${pt.y.toFixed(1)}`).join(" ");
  return { ...s, coords, d };
});

const seasonSummaries = ANALOG_SEASONS.map((season, i) => {
  const items = series.map((s) => ({
    id: s.id,
    short: s.id,
    val: s.values[i] !== null ? `${formatAnomaly(s.values[i]!)}°` : null,
  }));
  return {
    season,
    period: seasonLabel(season),
    x: xFor(i),
    items,
  };
});

const defaultReadout = "Pasá el cursor o deslizá sobre el gráfico para comparar cada trimestre";
---

<div
  class="chart-wrap analog-wrap"
  data-analog-chart
  data-seasons={JSON.stringify(seasonSummaries)}
  data-default-readout={defaultReadout}
>
  <div class="chart-toolbar">
    <div class="chart-readout" aria-live="polite">
      <span class="chart-readout-dot"></span>
      <span data-analog-readout>{defaultReadout}</span>
    </div>
    <div class="analog-toggles">
      {
        builtSeries.map((s) => (
          <button
            type="button"
            class={`analog-btn${s.defaultActive ? " is-active" : ""}`}
            data-analog-toggle={s.id}
            aria-pressed={s.defaultActive ? "true" : "false"}
          >
            <i style={`background:${s.color}`} />
            {s.label}
          </button>
        ))
      }
    </div>
  </div>

  <svg
    class="analog-svg"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="Comparador de curvas ONI de años análogos trimestre a trimestre"
    preserveAspectRatio="xMidYMid meet"
  >
    <rect
      x={padL}
      y={neutralTop}
      width={plotW}
      height={Math.max(neutralBottom - neutralTop, 1)}
      style="fill:rgba(234,242,249,0.05)"
    />

    {
      ticks.map((v) => (
        <g>
          <line
            x1={padL}
            x2={W - padR}
            y1={yFor(v)}
            y2={yFor(v)}
            stroke={v === 0 ? "rgba(234,242,249,0.38)" : "rgba(234,242,249,0.1)"}
            stroke-width={v === 0 ? 1.4 : 1}
            stroke-dasharray={v === 0 ? "0" : "3 6"}
          />
          <text
            x={padL - 10}
            y={yFor(v) + 4}
            text-anchor="end"
            fill="#7d94a8"
            font-size="12"
            font-family={monoFont}
          >
            {v > 0 ? `+${v}` : v}
          </text>
        </g>
      ))
    }

    <line
      class="analog-guide is-hidden"
      data-analog-guide
      x1={padL}
      x2={padL}
      y1={padT}
      y2={H - padB}
      stroke="var(--sol)"
      stroke-width="1"
      stroke-dasharray="3 4"
      opacity="0.75"
    />

    {
      ANALOG_SEASONS.map((season, i) => (
        <text
          x={xFor(i)}
          y={H - 12}
          text-anchor="middle"
          fill="#7d94a8"
          font-size="12"
          font-family={monoFont}
        >
          {season}
        </text>
      ))
    }

    {
      builtSeries.map((s) => (
        <g
          class={`analog-line-group${s.defaultActive ? "" : " is-hidden"}`}
          data-analog-series={s.id}
        >
          <path
            d={s.d}
            fill="none"
            stroke={s.color}
            stroke-width={s.isCurrent ? "3.4" : "2"}
            opacity={s.isCurrent ? "1" : "0.84"}
          />
          {s.coords.map((pt) => (
            <circle
              cx={pt.x}
              cy={pt.y}
              r={s.isCurrent ? "4.6" : "3.2"}
              fill={s.color}
            >
              <title>{`${s.label} · ${pt.season}: ${formatAnomaly(pt.v)} °C`}</title>
            </circle>
          ))}
        </g>
      ))
    }
  </svg>

  <div class="legend">
    <span><i style="background:var(--sol)"></i> Año en curso</span>
    <span><i style="background:var(--nino)"></i> Grandes eventos El Niño</span>
    <span><i style="background:var(--nina)"></i> La Niña triple (2021)</span>
    <span>Franja gris: zona neutral (−0,5° a +0,5°)</span>
  </div>
</div>

<script>
  interface SeasonData {
    season: string;
    period: string;
    x: number;
    items: { id: string; short: string; val: string | null }[];
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-analog-chart]")) {
    const btns = root.querySelectorAll<HTMLButtonElement>("[data-analog-toggle]");
    const readout = root.querySelector<HTMLElement>("[data-analog-readout]");
    const svg = root.querySelector<SVGSVGElement>("svg.analog-svg");
    const guide = root.querySelector<SVGLineElement>("[data-analog-guide]");
    const defaultText = root.dataset.defaultReadout ?? "";
    const seasons: SeasonData[] = JSON.parse(root.dataset.seasons ?? "[]");
    let currentIdx: number | null = null;

    const getActiveIds = () =>
      new Set(
        Array.from(btns)
          .filter((b) => b.classList.contains("is-active"))
          .map((b) => b.dataset.analogToggle ?? ""),
      );

    const updateReadout = (idx: number | null) => {
      currentIdx = idx;
      if (!readout) return;
      if (idx === null || !seasons[idx]) {
        readout.textContent = defaultText;
        guide?.classList.add("is-hidden");
        return;
      }
      const s = seasons[idx];
      const activeIds = getActiveIds();
      const parts = s.items
        .filter((it) => activeIds.has(it.id) && it.val !== null)
        .map((it) => `${it.short}: ${it.val}`);
      readout.textContent = `${s.season} (${s.period}) · ${parts.join(" · ")}`;
      if (guide) {
        guide.setAttribute("x1", String(s.x));
        guide.setAttribute("x2", String(s.x));
        guide.classList.remove("is-hidden");
      }
    };

    for (const btn of btns) {
      btn.addEventListener("click", () => {
        const id = btn.dataset.analogToggle;
        const active = !btn.classList.contains("is-active");
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-pressed", String(active));
        const grp = root.querySelector<SVGGElement>(`[data-analog-series="${id}"]`);
        grp?.classList.toggle("is-hidden", !active);
        if (currentIdx !== null) updateReadout(currentIdx);
      });
    }

    if (svg && seasons.length) {
      const handlePointer = (e: PointerEvent) => {
        const rect = svg.getBoundingClientRect();
        if (!rect.width) return;
        const relX = ((e.clientX - rect.left) / rect.width) * 1000;
        const padL = 56;
        const plotW = 1000 - 56 - 26;
        const ratio = (relX - padL) / plotW;
        const idx = Math.min(
          seasons.length - 1,
          Math.max(0, Math.round(ratio * (seasons.length - 1))),
        );
        updateReadout(idx);
      };

      svg.addEventListener("pointermove", handlePointer);
      svg.addEventListener("pointerdown", handlePointer);
      svg.addEventListener("pointerleave", () => updateReadout(null));
    }
  }
</script>
