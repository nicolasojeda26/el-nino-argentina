---
import "maplibre-gl/dist/maplibre-gl.css";
import { provinceByName, regions } from "../data/content";
import map from "../data/argentina-map.json";

const { viewBox, provinces } = map;

const regionMeta = Object.fromEntries(regions.map((r) => [r.slug, r]));
const provincesByRegion = regions.reduce<Record<string, string[]>>((acc, r) => {
  acc[r.slug] = provinces.filter((p) => p.region === r.slug).map((p) => p.name);
  return acc;
}, {});

const allProvinces = Object.values(provinceByName).sort((a, b) =>
  a.name.localeCompare(b.name, "es"),
);
const regionNames = Object.fromEntries(regions.map((r) => [r.slug, r.name]));
const defaultStatus =
  "Mapa 3D: usá \"Ir a\" para ver una región en relieve, arrastrá para explorar y tocá una provincia, alerta o estación";
---

<figure
  class="armap armap-3d"
  data-default-status={defaultStatus}
  data-region-names={JSON.stringify(regionNames)}
>
  <div class="armap-toolbar">
    <div class="armap-status" data-map-status aria-live="polite">
      <span class="armap-status-dot"></span>
      <span data-map-status-text>{defaultStatus}</span>
    </div>
    <div class="armap-controls" role="group" aria-label="Vista del mapa">
      <button type="button" class="armap-btn" data-map-pitch aria-pressed="true">3D</button>
      <button type="button" class="armap-btn" data-map-globe aria-pressed="false">Globo</button>
      <button type="button" class="armap-btn" data-map-reset>Centrar</button>
    </div>
  </div>

  <div class="armap-subbar">
    <div class="armap-regions" role="group" aria-label="Volar a una región">
      <span class="armap-subbar-label">Ir a</span>
      {
        regions.map((r) => (
          <button type="button" class="armap-chip" data-map-fly={r.slug} data-region={r.slug}>
            <span class="armap-chip-dot" aria-hidden="true" />
            {r.name}
          </button>
        ))
      }
    </div>
    <div class="armap-layers" role="group" aria-label="Capas del mapa">
      <span class="armap-subbar-label">Capas</span>
      <button type="button" class="armap-chip" data-map-layer="alertas" aria-pressed="true">
        Alertas SMN
      </button>
      <button type="button" class="armap-chip" data-map-layer="estaciones" aria-pressed="true">
        Estaciones INA
      </button>
    </div>
  </div>

  <div class="armap-canvas">
    <div
      class="armap-gl"
      data-map3d
      tabindex="0"
      role="region"
      aria-label="Mapa interactivo de Argentina con relieve, provincias, alertas del SMN y estaciones del INA"
    >
    </div>
    <div class="armap-live" data-map-live hidden></div>
    <div class="armap-tip" data-map-tip hidden></div>

    <div class="armap-fallback" data-map-fallback>
      <svg
        class="armap-svg"
        viewBox={viewBox}
        role="img"
        aria-label="Mapa de Argentina dividido en cinco regiones climáticas y 24 jurisdicciones"
      >
        <g class="armap-provs">
          {
            provinces.map((p) => {
              const pInfo = provinceByName[p.name];
              const href = pInfo ? `/impactos/provincia/${pInfo.slug}/` : `/impactos/${p.region}/`;
              const regName = regionMeta[p.region]?.name ?? p.region;
              return (
                <a
                  class="prov"
                  href={href}
                  data-region={p.region}
                  data-prov-name={p.name}
                  data-region-name={regName}
                  aria-label={`${p.name}: ver impactos en ${p.name} (${regName})`}
                >
                  <path d={p.d} />
                  <title>{`${p.name} (${regName}) — clic para ver ficha provincial`}</title>
                </a>
              );
            })
          }
        </g>
      </svg>
      <p class="armap-fallback-note" data-map-fallback-note>Cargando mapa 3D…</p>
    </div>
  </div>

  <ul class="armap-key" aria-label="Referencias del mapa">
    <li><span class="key-dot key-amarillo" aria-hidden="true"></span>Alerta SMN</li>
    <li><span class="key-dot key-naranja" aria-hidden="true"></span>Alerta naranja</li>
    <li><span class="key-dot key-rojo" aria-hidden="true"></span>Alerta roja / evacuación</li>
    <li><span class="key-dot key-ina" aria-hidden="true"></span>Estación INA</li>
    <li><span class="key-line" aria-hidden="true"></span>Límite provincial</li>
  </ul>

  <ul class="armap-legend">
    {
      regions.map((r) => (
        <li class="leg" data-region={r.slug} data-region-name={r.name}>
          <span class="swatch" aria-hidden="true" />
          <span class="leg-body">
            <a class="leg-name" href={`/impactos/${r.slug}/`}>
              {r.name}
            </a>
            <span class="leg-prov">{provincesByRegion[r.slug]?.join(" · ")}</span>
          </span>
        </li>
      ))
    }
  </ul>

  <details class="armap-prov-list">
    <summary>Ver las 24 jurisdicciones</summary>
    <ul>
      {
        allProvinces.map((p) => (
          <li>
            <a href={`/impactos/provincia/${p.slug}/`}>{p.name}</a>
            <span>{regionMeta[p.regionSlug]?.name ?? p.regionSlug}</span>
          </li>
        ))
      }
    </ul>
  </details>

  <figcaption class="armap-cap">
    Arrastrá para explorar (clic derecho o dos dedos para inclinar y girar), usá "Ir a" para ver cada
    región en relieve y tocá una provincia, un área de alerta o una estación para ver el detalle. En
    escritorio, la rueda del mouse no secuestra el scroll de la página.
    <span class="armap-attr">
      Mapa: MapLibre GL · Datos: OpenFreeMap / OpenStreetMap · Relieve: Mapterhorn · Provincias: Natural
      Earth · Alertas: SMN / INA.
    </span>
  </figcaption>
</figure>

<script>
  import type { Map as MapLibreMap, MapGeoJSONFeature } from "maplibre-gl";
  import maplibreWorkerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?url";

  type SmnAlert = {
    id: string;
    event: string;
    level: string;
    levelLabel: string;
    area: string;
    expires: string;
    description?: string;
    instruction?: string;
    url?: string;
    polygons?: number[][][];
  };

  type InaStation = {
    station: string;
    river: string;
    kind: string;
    value: number | null;
    unit: string;
    status: string;
    trend: string;
    alert: string;
    updated?: string;
    lat: number;
    lon: number;
    url?: string;
  };

  type AlertData = {
    smn?: SmnAlert[];
    ina?: InaStation[];
    counts?: Record<string, number>;
  };

  const root = document.querySelector<HTMLElement>(".armap-3d");

  if (root) {
    const glEl = root.querySelector<HTMLElement>("[data-map3d]");
    const liveEl = root.querySelector<HTMLElement>("[data-map-live]");
    const fallbackNote = root.querySelector<HTMLElement>("[data-map-fallback-note]");
    const statusText = root.querySelector<HTMLElement>("[data-map-status-text]");
    const pitchBtn = root.querySelector<HTMLButtonElement>("[data-map-pitch]");
    const globeBtn = root.querySelector<HTMLButtonElement>("[data-map-globe]");
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-map-reset]");
    const tipEl = root.querySelector<HTMLElement>("[data-map-tip]");
    const flyBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-map-fly]"));
    const layerBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-map-layer]"));
    const legendItems = Array.from(root.querySelectorAll<HTMLElement>(".leg[data-region]"));
    const finePointer = window.matchMedia("(pointer: fine)").matches;
    const layerVisible: Record<string, boolean> = { alertas: true, estaciones: true };
    const defaultStatus = root.dataset.defaultStatus ?? "";
    const regionNames: Record<string, string> = JSON.parse(
      root.dataset.regionNames ?? "{}",
    );

    let map: MapLibreMap | null = null;
    let maplibregl: typeof import("maplibre-gl") | null = null;
    let is3D = true;
    let isGlobe = false;
    let appliedTheme: "light" | "dark" | null = null;
    let hoveredSlug: string | null = null;
    let launched = false;
    let openPopup: import("maplibre-gl").Popup | null = null;
    const closePopup = () => {
      openPopup?.remove();
      openPopup = null;
    };

    const setStatus = (text: string) => {
      if (statusText) statusText.textContent = text;
    };

    const fail = (message: string) => {
      root.classList.remove("map-loading");
      root.classList.add("map-failed");
      if (fallbackNote) fallbackNote.textContent = message;
      setStatus(
        "Mapa 3D no disponible. Usá el mapa esquemático o abrí una provincia desde la lista.",
      );
    };

    const supportsWebGL2 = () => {
      try {
        const canvas = document.createElement("canvas");
        return Boolean(
          window.WebGL2RenderingContext && canvas.getContext("webgl2"),
        );
      } catch {
        return false;
      }
    };

    const thumb = (value: number | null, unit: string) => {
      if (value === null || value === undefined || Number.isNaN(value)) {
        return "s/d";
      }
      return `${new Intl.NumberFormat("es-AR", { maximumFractionDigits: 2 }).format(value)} ${unit}`;
    };

    const dateLabel = (iso?: string) => {
      if (!iso) return "";
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return "";
      return new Intl.DateTimeFormat("es-AR", {
        dateStyle: "short",
        timeStyle: "short",
        hour12: false,
      }).format(date);
    };

    const escapeHtml = (value: unknown) =>
      String(value ?? "").replace(
        /[&<>"']/g,
        (char) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[char] ?? char,
      );

    const themeName = (): "light" | "dark" =>
      document.documentElement.getAttribute("data-theme") === "dark"
        ? "dark"
        : "light";

    const styleUrl = (theme: "light" | "dark") =>
      theme === "dark"
        ? "https://tiles.openfreemap.org/styles/dark"
        : "https://tiles.openfreemap.org/styles/positron";

    const start = async () => {
      if (launched) return;
      launched = true;
      if (!glEl) return;
      if (!supportsWebGL2()) {
        fail("Este navegador no tiene WebGL 2: mostrando el mapa esquemático.");
        return;
      }

      root.classList.add("map-loading");
      setStatus("Cargando mapa 3D…");

      try {
        const [ml, provincesResponse, alertsResponse] = await Promise.all([
          import("maplibre-gl"),
          fetch("/data/argentina-provinces.geojson"),
          fetch("/datos/alertas.json").catch(() => null),
        ]);

        if (!provincesResponse.ok) {
          throw new Error(`Geometría provincial: HTTP ${provincesResponse.status}`);
        }

        const provincesGeo = await provincesResponse.json();
        const alerts: AlertData =
          alertsResponse && alertsResponse.ok
            ? await alertsResponse.json()
            : { smn: [], ina: [] };

        const alertFeatures = (alerts.smn ?? []).flatMap((alert, alertIndex) =>
          (alert.polygons ?? []).map((ring, polygonIndex) => ({
            type: "Feature" as const,
            id: `${alert.id}-${alertIndex}-${polygonIndex}`,
            geometry: { type: "Polygon" as const, coordinates: [ring] },
            properties: {
              event: alert.event,
              level: alert.level,
              levelLabel: alert.levelLabel,
              area: alert.area,
              expires: alert.expires,
              description: alert.description ?? "",
              instruction: alert.instruction ?? "",
              url: alert.url ?? "",
            },
          })),
        );

        const stationFeatures = (alerts.ina ?? []).map((station, index) => ({
          type: "Feature" as const,
          id: index,
          geometry: {
            type: "Point" as const,
            coordinates: [station.lon, station.lat],
          },
          properties: {
            station: station.station,
            river: station.river,
            kind: station.kind,
            value: station.value,
            unit: station.unit,
            status: station.status,
            trend: station.trend,
            alert: station.alert,
            updated: station.updated ?? "",
            url: station.url ?? "",
          },
        }));

        maplibregl = ml;
        ml.setWorkerUrl(maplibreWorkerUrl);
        appliedTheme = themeName();

        map = new ml.Map({
          container: glEl,
          style: styleUrl(appliedTheme),
          bounds: [
            [-73.6, -55.25],
            [-53.55, -21.65],
          ],
          fitBoundsOptions: { padding: 22, pitch: 26, bearing: -6 },
          minZoom: 2.2,
          maxZoom: 12,
          maxPitch: 75,
          scrollZoom: false,
          cooperativeGestures: window.matchMedia("(pointer: coarse)").matches,
          attributionControl: {
            compact: true,
            customAttribution:
              'Base: <a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
          },
          // Suavizado solo con puntero fino (escritorio) y resolución tope 2x:
          // en celulares y pantallas 3x el costo de GPU se dispara sin ganancia visible.
          canvasContextAttributes: { antialias: finePointer },
          pixelRatio: Math.min(window.devicePixelRatio || 1, 2),
          fadeDuration: 150,
        });

        map.addControl(
          new ml.NavigationControl({ visualizePitch: true, showCompass: true }),
          "top-right",
        );
        map.addControl(new ml.FullscreenControl({ container: root.querySelector<HTMLElement>(".armap-canvas") ?? undefined }), "top-right");
        map.addControl(
          new ml.ScaleControl({ unit: "metric", maxWidth: 110 }),
          "bottom-left",
        );

        const firstLayerOfType = (types: string[]) =>
          map
            ?.getStyle()
            .layers?.find((layer) => types.includes(layer.type))?.id;

        const applyTerrain = () => {
          if (!map) return;
          if (is3D) {
            map.setTerrain({ source: "terrain", exaggeration: 1.6 });
          } else {
            map.setTerrain(null);
          }
        };

        const applySky = () => {
          if (!map || typeof map.setSky !== "function") return;
          const dark = appliedTheme === "dark";
          try {
            map.setSky({
              "sky-color": dark ? "#0b1c2e" : "#a9c9e2",
              "horizon-color": dark ? "#071322" : "#f4f1e9",
              "fog-color": dark ? "#071322" : "#f4f1e9",
              "sky-horizon-blend": 0.55,
              "horizon-fog-blend": 0.6,
              "fog-ground-blend": 0.55,
            });
          } catch {
            /* estilos sin soporte de cielo */
          }
        };

        const layerGroups: Record<string, string[]> = {
          alertas: ["alert-fill", "alert-line"],
          estaciones: ["station-pulse", "station-dot"],
        };

        const applyLayerVisibility = () => {
          if (!map) return;
          for (const [group, ids] of Object.entries(layerGroups)) {
            for (const id of ids) {
              if (map.getLayer(id)) {
                map.setLayoutProperty(id, "visibility", layerVisible[group] ? "visible" : "none");
              }
            }
          }
          for (const btn of layerBtns) {
            const group = btn.dataset.mapLayer ?? "";
            btn.setAttribute("aria-pressed", String(Boolean(layerVisible[group])));
          }
        };

        const installOverlays = () => {
          if (!map || !maplibregl) return;

          if (!map.getSource("terrain")) {
            map.addSource("terrain", {
              type: "raster-dem",
              url: "https://tiles.mapterhorn.com/tilejson.json",
              tileSize: 512,
              encoding: "terrarium",
              attribution: "Mapterhorn",
            });
          }

          if (!map.getSource("hillshade-dem")) {
            map.addSource("hillshade-dem", {
              type: "raster-dem",
              url: "https://tiles.mapterhorn.com/tilejson.json",
              tileSize: 512,
              encoding: "terrarium",
            });
          }

          const firstLineOrSymbol = firstLayerOfType(["line", "symbol"]);
          const firstSymbol = firstLayerOfType(["symbol"]);

          if (!map.getSource("provincias")) {
            map.addSource("provincias", {
              type: "geojson",
              data: provincesGeo,
              promoteId: "slug",
            });
          }

          if (!map.getLayer("prov-fill")) {
            map.addLayer(
              {
                id: "prov-fill",
                type: "fill",
                source: "provincias",
                paint: {
                  "fill-color": [
                    "match",
                    ["get", "region"],
                    "litoral",
                    "#2e86c1",
                    "pampeana",
                    "#e9a800",
                    "cuyo",
                    "#8e4585",
                    "noa",
                    "#d2521f",
                    "patagonia",
                    "#2e9e8f",
                    "#8794a3",
                  ],
                  "fill-opacity": [
                    "case",
                    ["boolean", ["feature-state", "hover"], false],
                    0.55,
                    ["boolean", ["feature-state", "focus"], false],
                    0.5,
                    ["boolean", ["feature-state", "dim"], false],
                    0.07,
                    0.26,
                  ],
                  "fill-opacity-transition": { duration: 220 },
                },
              },
              firstLineOrSymbol,
            );
          }

          // El sombreado va ENCIMA del color de las provincias para que el relieve
          // (Andes, sierras) se lea aun a escala país.
          if (!map.getLayer("hillshade")) {
            const dark = appliedTheme === "dark";
            map.addLayer(
              {
                id: "hillshade",
                type: "hillshade",
                source: "hillshade-dem",
                paint: {
                  "hillshade-exaggeration": dark ? 0.6 : 0.5,
                  "hillshade-shadow-color": dark ? "#000000" : "#16232f",
                  "hillshade-highlight-color": dark ? "#5f7f9c" : "#ffffff",
                  "hillshade-accent-color": dark ? "#0b1c2e" : "#55616d",
                  "hillshade-illumination-direction": 315,
                },
              },
              firstLineOrSymbol,
            );
          }

          if (!map.getLayer("prov-line")) {
            map.addLayer(
              {
                id: "prov-line",
                type: "line",
                source: "provincias",
                paint: {
                  "line-color": "rgba(255,253,246,0.72)",
                  "line-width": 1,
                  "line-opacity": 0.9,
                },
              },
              firstSymbol,
            );
          }

          if (alertFeatures.length && !map.getSource("alertas")) {
            map.addSource("alertas", {
              type: "geojson",
              data: {
                type: "FeatureCollection",
                features: alertFeatures,
              },
            });
          }

          if (alertFeatures.length && !map.getLayer("alert-fill")) {
            map.addLayer(
              {
                // Áreas planas apoyadas sobre el relieve: las extrusiones de decenas de km
                // tapaban el mapa y eran lo más caro de dibujar.
                id: "alert-fill",
                type: "fill",
                source: "alertas",
                paint: {
                  "fill-color": [
                    "match",
                    ["get", "level"],
                    "rojo",
                    "#d64545",
                    "naranja",
                    "#e08a1e",
                    "amarillo",
                    "#e9b400",
                    "#9fb0c0",
                  ],
                  "fill-opacity": [
                    "match",
                    ["get", "level"],
                    "rojo",
                    0.3,
                    "naranja",
                    0.18,
                    0.08,
                  ],
                },
              },
              firstSymbol,
            );
          }

          if (alertFeatures.length && !map.getLayer("alert-line")) {
            map.addLayer(
              {
                id: "alert-line",
                type: "line",
                source: "alertas",
                paint: {
                  "line-color": [
                    "match",
                    ["get", "level"],
                    "rojo",
                    "#ff8f8f",
                    "naranja",
                    "#ffc27a",
                    "amarillo",
                    "#d4a400",
                    "#c7d6e4",
                  ],
                  "line-width": 1.3,
                  "line-opacity": 0.85,
                },
              },
              firstSymbol,
            );
          }

          if (stationFeatures.length && !map.getSource("estaciones")) {
            map.addSource("estaciones", {
              type: "geojson",
              data: {
                type: "FeatureCollection",
                features: stationFeatures,
              },
            });
          }

          if (stationFeatures.length && !map.getLayer("station-pulse")) {
            map.addLayer({
              id: "station-pulse",
              type: "circle",
              source: "estaciones",
              filter: ["!=", ["get", "alert"], "ok"],
              paint: {
                "circle-color": [
                  "match",
                  ["get", "alert"],
                  "evacuacion",
                  "#d64545",
                  "alerta",
                  "#e08a1e",
                  "#2e86c1",
                ],
                // Halo fijo: antes se animaba en cada cuadro y obligaba a redibujar
                // todo el mapa (con relieve) 60 veces por segundo.
                "circle-radius": ["match", ["get", "alert"], "evacuacion", 15, 12],
                "circle-opacity": 0.22,
                "circle-blur": 0.45,
                "circle-pitch-alignment": "viewport",
              },
            });
          }

          if (stationFeatures.length && !map.getLayer("station-dot")) {
            map.addLayer({
              id: "station-dot",
              type: "circle",
              source: "estaciones",
              paint: {
                "circle-color": [
                  "match",
                  ["get", "alert"],
                  "evacuacion",
                  "#d64545",
                  "alerta",
                  "#e08a1e",
                  "ok",
                  "#7d8fa3",
                  "#2e86c1",
                ],
                "circle-radius": [
                  "match",
                  ["get", "alert"],
                  "evacuacion",
                  7,
                  "alerta",
                  6,
                  4,
                ],
                "circle-stroke-width": 2,
                "circle-stroke-color": "#fffdf6",
                "circle-opacity": 0.96,
                "circle-pitch-alignment": "viewport",
              },
            });
          }

          applyTerrain();
          applySky();
          applyLayerVisibility();
          // La atribución arranca plegada (botón "i"); se despliega al tocarla.
          root
            .querySelector(".maplibregl-ctrl-attrib.maplibregl-compact-show")
            ?.classList.remove("maplibregl-compact-show");

          root.classList.remove("map-loading", "map-failed");
          root.classList.add("map-ready");
          setStatus(defaultStatus);

          const counts = alerts.counts;
          if (liveEl && counts) {
            const parts: string[] = [];
            if (counts.inaEvacuation) {
              parts.push(`${counts.inaEvacuation} evacuaciones INA`);
            }
            if (counts.inaAlerts) {
              parts.push(`${counts.inaAlerts} alertas hídricas`);
            }
            if (counts.smn) {
              parts.push(`${counts.smn} avisos SMN`);
            }
            if (parts.length) {
              liveEl.textContent = parts.join(" · ");
              liveEl.hidden = false;
            }
          }
        };

        map.on("style.load", installOverlays);
        map.on("load", installOverlays);

        map.on("error", (event) => {
          console.warn("[mapa]", event.error?.message ?? event);
        });

        const pickFeature = (
          point: { x: number; y: number },
        ): MapGeoJSONFeature | undefined => {
          if (!map) return undefined;
          const layers = ["station-dot", "alert-fill", "prov-fill"].filter(
            (id) => map?.getLayer(id),
          );
          if (!layers.length) return undefined;
          const features = map.queryRenderedFeatures([point.x, point.y], { layers });
          return (
            features.find((f) => f.layer.id === "station-dot") ??
            features.find((f) => f.layer.id === "alert-fill") ??
            features.find((f) => f.layer.id === "prov-fill")
          );
        };

        const setProvinceHover = (slug: string | null) => {
          if (!map || !map.getSource("provincias")) return;
          if (hoveredSlug && hoveredSlug !== slug) {
            map.setFeatureState(
              { source: "provincias", id: hoveredSlug },
              { hover: false },
            );
          }
          if (slug) {
            map.setFeatureState(
              { source: "provincias", id: slug },
              { hover: true },
            );
          }
          hoveredSlug = slug;
        };

        const hideTip = () => {
          if (tipEl) tipEl.hidden = true;
        };

        const showTip = (point: { x: number; y: number }, title: string, detail: string) => {
          if (!tipEl || !finePointer) return;
          tipEl.innerHTML = `<strong>${escapeHtml(title)}</strong>${detail ? `<span>${escapeHtml(detail)}</span>` : ""}`;
          tipEl.hidden = false;
          const canvas = map?.getCanvas();
          const maxX = (canvas?.clientWidth ?? 0) - tipEl.offsetWidth - 8;
          const x = Math.max(8, Math.min(point.x + 14, maxX));
          const y = Math.max(8, point.y - tipEl.offsetHeight - 12);
          tipEl.style.transform = `translate(${x}px, ${y}px)`;
        };

        // Hover limitado a una consulta por cuadro y pausado mientras se arrastra:
        // queryRenderedFeatures con relieve activo es caro.
        let pendingPoint: { x: number; y: number } | null = null;
        let hoverFrame = 0;

        const resolveHover = () => {
          hoverFrame = 0;
          const point = pendingPoint;
          pendingPoint = null;
          if (!map || !point) return;
          const feature = pickFeature(point);
          if (!feature) {
            setProvinceHover(null);
            map.getCanvas().style.cursor = "";
            setStatus(defaultStatus);
            hideTip();
            return;
          }

          map.getCanvas().style.cursor = "pointer";
          const props = feature.properties ?? {};

          if (feature.layer.id === "station-dot") {
            setProvinceHover(null);
            setStatus(
              `INA · ${props.station} (${props.river}): ${thumb(props.value, props.unit)} · ${props.status} — clic para detalles`,
            );
            showTip(point, `${props.station} · río ${props.river}`, `${thumb(props.value, props.unit)} · ${props.status}`);
          } else if (feature.layer.id === "alert-fill") {
            setProvinceHover(null);
            setStatus(
              `SMN · ${props.event} · alerta ${props.levelLabel} · ${props.area} — clic para detalles`,
            );
            showTip(point, `${props.event}`, `Alerta ${props.levelLabel} · ${props.area}`);
          } else {
            const slug = String(props.slug ?? "");
            setProvinceHover(slug || null);
            const regionName = regionNames[props.region] ?? props.region;
            setStatus(`${props.name} · ${regionName} — clic para ver el resumen`);
            showTip(point, String(props.name), String(regionName));
          }
        };

        map.on("mousemove", (event) => {
          if (map?.isMoving()) {
            hideTip();
            return;
          }
          pendingPoint = event.point;
          if (!hoverFrame) hoverFrame = requestAnimationFrame(resolveHover);
        });

        map.on("movestart", hideTip);

        map.getCanvas().addEventListener("mouseleave", () => {
          pendingPoint = null;
          setProvinceHover(null);
          hideTip();
          if (map) map.getCanvas().style.cursor = "";
          setStatus(defaultStatus);
        });

        map.on("click", (event) => {
          if (!map || !maplibregl) return;
          const feature = pickFeature(event.point);
          if (!feature) return;
          const props = feature.properties ?? {};

          hideTip();
          let html = "";

          if (feature.layer.id === "prov-fill") {
            const slug = String(props.slug ?? "");
            const regionSlug = String(props.region ?? "");
            html = `
              <div class="map-popup">
                <p class="map-popup-kicker">Provincia · ${escapeHtml(regionNames[regionSlug] ?? regionSlug)}</p>
                <strong>${escapeHtml(props.name)}</strong>
                <p>Cómo la afectan El Niño y La Niña: lluvias, ríos y producción.</p>
                ${slug ? `<a href="/impactos/provincia/${escapeHtml(slug)}/">Ver ficha provincial →</a>` : ""}
                ${regionSlug ? `<a class="map-popup-secondary" href="/impactos/${escapeHtml(regionSlug)}/">Ver ${escapeHtml(regionNames[regionSlug] ?? regionSlug)} →</a>` : ""}
              </div>`;
          } else if (feature.layer.id === "station-dot") {
            html = `
              <div class="map-popup">
                <p class="map-popup-kicker">INA · ${escapeHtml(props.kind)}</p>
                <strong>${escapeHtml(props.station)}</strong>
                <p>Río ${escapeHtml(props.river)}</p>
                <p class="map-popup-value">${escapeHtml(thumb(props.value, props.unit))} · ${escapeHtml(props.status)}</p>
                <p>Tendencia: ${escapeHtml(props.trend)}${props.updated ? ` · ${escapeHtml(props.updated)}` : ""}</p>
                ${
                  props.url
                    ? `<a href="${escapeHtml(props.url)}" target="_blank" rel="noopener noreferrer">Ver serie completa ↗</a>`
                    : ""
                }
              </div>`;
          } else if (feature.layer.id === "alert-fill") {
            html = `
              <div class="map-popup">
                <p class="map-popup-kicker">SMN · Alerta ${escapeHtml(props.levelLabel)}</p>
                <strong>${escapeHtml(props.event)}</strong>
                <p>${escapeHtml(props.area)}</p>
                <p>Vigente hasta ${escapeHtml(dateLabel(props.expires))}</p>
                ${props.description ? `<p>${escapeHtml(props.description)}</p>` : ""}
                ${
                  props.instruction
                    ? `<details><summary>Recomendaciones</summary><p>${escapeHtml(props.instruction)}</p></details>`
                    : ""
                }
                ${
                  props.url
                    ? `<a href="${escapeHtml(props.url)}" target="_blank" rel="noopener noreferrer">Aviso oficial ↗</a>`
                    : ""
                }
              </div>`;
          }

          if (html) {
            closePopup();
            openPopup = new maplibregl.Popup({
              closeButton: true,
              maxWidth: "320px",
              className: "armap-popup",
            })
              .setLngLat(event.lngLat)
              .setHTML(html)
              .addTo(map);
          }
        });

        const syncButtons = () => {
          if (pitchBtn) {
            pitchBtn.textContent = is3D ? "3D" : "2D";
            pitchBtn.setAttribute("aria-pressed", String(is3D));
          }
          if (globeBtn) {
            globeBtn.textContent = isGlobe ? "Plano" : "Globo";
            globeBtn.setAttribute("aria-pressed", String(isGlobe));
          }
        };

        const set3D = (next: boolean) => {
          is3D = next;
          syncButtons();
          if (!map) return;
          if (isGlobe) {
            isGlobe = false;
            map.setProjection({ type: "mercator" });
          }
          applyTerrain();
          map.easeTo({
            pitch: is3D ? 26 : 0,
            bearing: is3D ? -6 : 0,
            duration: 800,
          });
        };

        const setGlobe = (next: boolean) => {
          if (!map) return;
          isGlobe = next;
          syncButtons();
          map.setProjection({ type: next ? "globe" : "mercator" });
          map.easeTo({
            pitch: next || !is3D ? 0 : 26,
            bearing: next || !is3D ? 0 : -6,
            duration: 750,
          });
        };

        pitchBtn?.addEventListener("click", () => set3D(!is3D));
        globeBtn?.addEventListener("click", () => setGlobe(!isGlobe));
        resetBtn?.addEventListener("click", () => {
          if (!map) return;
          closePopup();
          focusedRegion = null;
          setRegionFocus(null);
          map.fitBounds(
            [
              [-73.6, -55.25],
              [-53.55, -21.65],
            ],
            {
              padding: 36,
              pitch: isGlobe ? 0 : is3D ? 26 : 0,
              bearing: isGlobe ? 0 : is3D ? -6 : 0,
              duration: 1100,
            },
          );
        });

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        // Límites de cada región calculados a partir de la geometría provincial.
        type Bounds = [[number, number], [number, number]];
        const regionBounds: Record<string, Bounds> = {};
        const regionSlugs: Record<string, string[]> = {};
        for (const feature of provincesGeo.features ?? []) {
          const region = feature.properties?.region;
          if (!region) continue;
          (regionSlugs[region] ??= []).push(feature.properties.slug);
          const rings: number[][][] =
            feature.geometry.type === "Polygon"
              ? feature.geometry.coordinates
              : feature.geometry.coordinates.flat();
          const b = (regionBounds[region] ??= [
            [Infinity, Infinity],
            [-Infinity, -Infinity],
          ]);
          for (const ring of rings) {
            for (const [lon, lat] of ring) {
              b[0][0] = Math.min(b[0][0], lon);
              b[0][1] = Math.min(b[0][1], lat);
              b[1][0] = Math.max(b[1][0], lon);
              b[1][1] = Math.max(b[1][1], lat);
            }
          }
        }

        const setRegionFocus = (region: string | null) => {
          if (!map || !map.getSource("provincias")) return;
          for (const [slugRegion, slugs] of Object.entries(regionSlugs)) {
            for (const slug of slugs) {
              map.setFeatureState(
                { source: "provincias", id: slug },
                {
                  focus: region !== null && slugRegion === region,
                  dim: region !== null && slugRegion !== region,
                },
              );
            }
          }
          for (const btn of flyBtns) {
            btn.setAttribute("aria-pressed", String(btn.dataset.mapFly === region));
          }
        };

        let focusedRegion: string | null = null;

        const flyToRegion = (region: string) => {
          if (!map) return;
          const bounds = regionBounds[region];
          if (!bounds) return;
          if (isGlobe) {
            isGlobe = false;
            map.setProjection({ type: "mercator" });
          }
          if (!is3D) {
            is3D = true;
            applyTerrain();
          }
          syncButtons();
          closePopup();
          focusedRegion = region;
          setRegionFocus(region);
          // Más inclinación en regiones con cordillera para que el relieve se vea.
          const mountainous = region === "cuyo" || region === "noa" || region === "patagonia";
          map.fitBounds(bounds, {
            padding: finePointer
              ? { top: 48, bottom: 36, left: 36, right: 64 }
              : { top: 56, bottom: 24, left: 16, right: 52 },
            pitch: mountainous ? 58 : 45,
            bearing: mountainous ? -18 : -8,
            duration: reduceMotion.matches ? 0 : 1800,
            essential: true,
          });
          setStatus(
            `${regionNames[region] ?? region}: ${finePointer ? "arrastrá con clic derecho para girar e inclinar" : "usá dos dedos para girar e inclinar"}`,
          );
        };

        flyBtns.forEach((btn) =>
          btn.addEventListener("click", () => {
            const region = btn.dataset.mapFly ?? "";
            if (focusedRegion === region) {
              focusedRegion = null;
              setRegionFocus(null);
              resetBtn?.click();
            } else {
              flyToRegion(region);
            }
          }),
        );

        layerBtns.forEach((btn) =>
          btn.addEventListener("click", () => {
            const group = btn.dataset.mapLayer ?? "";
            layerVisible[group] = !layerVisible[group];
            closePopup();
            applyLayerVisibility();
          }),
        );

        // La leyenda resalta su región en el mapa al pasar el mouse o enfocar.
        legendItems.forEach((item) => {
          const region = item.dataset.region ?? "";
          const enter = () => setRegionFocus(region);
          const leave = () => setRegionFocus(focusedRegion);
          item.addEventListener("mouseenter", enter);
          item.addEventListener("mouseleave", leave);
          item.addEventListener("focusin", enter);
          item.addEventListener("focusout", leave);
        });

        // Al cambiar de tema se recarga el estilo: restaurar el foco de región.
        map.on("style.load", () => setRegionFocus(focusedRegion));

        const themeObserver = new MutationObserver(() => {
          if (!map) return;
          const next = themeName();
          if (next === appliedTheme) return;
          appliedTheme = next;
          map.setStyle(styleUrl(next), { diff: false });
        });
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });

        window.addEventListener(
          "pagehide",
          () => {
            cancelAnimationFrame(hoverFrame);
            themeObserver.disconnect();
            map?.remove();
            map = null;
          },
          { once: true },
        );
      } catch (error) {
        console.error("[mapa]", error);
        fail("No se pudo cargar el mapa 3D. Mostrando el mapa esquemático.");
      }
    };

    if ("IntersectionObserver" in window) {
      setStatus("Mapa 3D listo para cargar cuando llegues a esta sección");
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            void start();
          }
        },
        { rootMargin: "240px" },
      );
      if (glEl) observer.observe(glEl);
    } else {
      void start();
    }
  }
</script>
