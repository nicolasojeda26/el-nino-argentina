---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AlertTicker from "../components/AlertTicker.astro";
import { site } from "../data/content";
import "../styles/global.css";

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  type?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  robots?: string;
  breadcrumbs?: Breadcrumb[];
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  type = "website",
  jsonLd,
  image,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  breadcrumbs,
} = Astro.props;

const origin = Astro.site ?? site.url;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(image ?? "/og.png", origin).href;
const logo = new URL("/apple-touch-icon.png", origin).href;

const baseSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  alternateName: site.domain,
  url: site.url,
  description: site.description,
  inLanguage: "es-AR",
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
    logo: { "@type": "ImageObject", url: logo, width: 180, height: 180 },
  },
};

const breadcrumbSchema = breadcrumbs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: new URL(b.path, origin).href,
      })),
    }
  : null;

const schemas = [baseSchema, breadcrumbSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])].filter(
  (s): s is Record<string, unknown> => Boolean(s),
);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-mono-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Notas`} href="/rss.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#f4f1e9" id="metaThemeColor" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("enso-theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved);
          const meta = document.getElementById("metaThemeColor");
          if (meta) meta.setAttribute("content", saved === "dark" ? "#071322" : "#f4f1e9");
        }
      } catch {}
    </script>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      site.adsenseClient && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    {site.adsenseClient && <meta name="google-adsense-account" content={site.adsenseClient} />}

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <AlertTicker />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
