---
import type { OniPoint } from "../data/oni";
import { classify, formatAnomaly, seasonLabel } from "../data/oni";

interface Props {
  points: OniPoint[];
  count?: number;
  height?: number;
  interactiveRange?: boolean;
}

const { points, count = 72, height = 320, interactiveRange = false } = Astro.props;

const W = 1000;
const H = height;
const padL = 52;
const padR = 18;
const padT = 34;
const padB = 36;
const plotW = W - padL - padR;
const plotH = H - padT - padB;
const monoFont = '"IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace';

function buildChart(sliceCount: number, key: string, label: string) {
  const data = points.slice(-sliceCount);
  const maxAbs = Math.max(1, ...data.map((d) => Math.abs(d.anomaly)));
  const scale = Math.ceil(maxAbs * 2) / 2;
  const top = Math.ceil(scale);
  const y0 = padT + plotH / 2;
  const yScale = plotH / 2 / scale;

  const n = data.length;
  const stepW = plotW / n;
  const barW = n > 200 ? Math.max(stepW + 0.15, 1.1) : Math.min(Math.max(stepW - 2, 0.8), stepW);

  const bars = data.map((d, i) => {
    const x = padL + i * stepW + (n > 200 ? 0 : (stepW - barW) / 2);
    const h = Math.max(Math.abs(d.anomaly) * yScale, 1.2);
    const y = d.anomaly >= 0 ? y0 - h : y0;
    const phase = d.anomaly >= 0.5 ? "nino" : d.anomaly <= -0.5 ? "nina" : "neutral";
    const fill =
      phase === "nino" ? "var(--nino)" : phase === "nina" ? "var(--nina)" : "var(--neutral)";
    const { state, intensity } = classify(d.anomaly);
    const summary = `${d.season} ${d.year} (${seasonLabel(d.season)}) · ONI ${formatAnomaly(d.anomaly)} °C · ${state}${state !== "Neutral" ? ` (${intensity.toLowerCase()})` : ""}`;
    return { x, y, h, fill, phase, d, summary };
  });

  const tickStep = top >= 2 ? 1 : 0.5;
  const ticks: number[] = [];
  for (let v = -top; v <= top + 1e-9; v += tickStep) {
    ticks.push(Math.round((v + Number.EPSILON) * 2) / 2);
  }

  const djfIndices = data
    .map((d, i) => ({ d, i }))
    .filter(({ d }) => d.season === "DJF");
  const labelEvery = Math.max(1, Math.ceil(djfIndices.length / 12));
  const yearLabels = djfIndices.filter((_, idx) => idx % labelEvery === 0);

  const yFor = (v: number) => y0 - v * yScale;
  const neutralTop = yFor(0.5);
  const neutralBottom = yFor(-0.5);
  const last = bars[bars.length - 1];

  return {
    key,
    label,
    n,
    stepW,
    barW,
    bars,
    ticks,
    yearLabels,
    yFor,
    neutralTop,
    neutralBottom,
    last,
  };
}

const views = interactiveRange
  ? [
      buildChart(40, "10y", "Últimos 10 años"),
      buildChart(120, "30y", "Últimos 30 años"),
      buildChart(points.length, "all", "1950 – hoy"),
    ]
  : [buildChart(count, "default", "")];

const initialView = views[views.length - 1];
const defaultReadout = initialView.last ? initialView.last.summary : "";
---

<div class="chart-wrap" data-oni-chart data-default-readout={defaultReadout}>
  <div class="chart-toolbar">
    <div class="chart-readout" data-chart-readout aria-live="polite">
      <span class="chart-readout-dot"></span>
      <span data-chart-readout-text>{defaultReadout}</span>
    </div>
    {
      interactiveRange && (
        <div class="chart-ranges" role="tablist" aria-label="Rango de años">
          {views.map((v, idx) => (
            <button
              type="button"
              role="tab"
              class={`chart-range-btn${idx === views.length - 1 ? " is-active" : ""}`}
              aria-selected={idx === views.length - 1 ? "true" : "false"}
              data-range-btn={v.key}
            >
              {v.label}
            </button>
          ))}
        </div>
      )
    }
  </div>

  {
    views.map((v, idx) => (
      <svg
        class={`chart-svg${idx !== views.length - 1 ? " is-hidden" : ""}`}
        data-range-panel={v.key}
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={`Serie de tiempo del índice ONI, últimos ${v.n} trimestres`}
        preserveAspectRatio="xMidYMid meet"
      >
        <rect
          x={padL}
          y={v.neutralTop}
          width={plotW}
          height={Math.max(v.neutralBottom - v.neutralTop, 1)}
          style="fill:rgba(234,242,249,0.05)"
        />

        {v.ticks.map((t) => (
          <g>
            <line
              x1={padL}
              x2={W - padR}
              y1={v.yFor(t)}
              y2={v.yFor(t)}
              stroke={t === 0 ? "rgba(234,242,249,0.38)" : "rgba(234,242,249,0.1)"}
              stroke-width={t === 0 ? 1.4 : 1}
              stroke-dasharray={t === 0 ? "0" : "3 6"}
            />
            <text
              x={padL - 10}
              y={v.yFor(t) + 4}
              text-anchor="end"
              fill="#7d94a8"
              font-size="12"
              font-family={monoFont}
            >
              {t > 0 ? `+${t}` : t}
            </text>
          </g>
        ))}

        {v.bars.map((b) => (
          <rect
            class="chart-bar"
            x={b.x}
            y={b.y}
            width={v.barW}
            height={b.h}
            rx="1"
            data-summary={b.summary}
            style={`fill:${b.fill}`}
          >
            <title>{b.summary}</title>
          </rect>
        ))}

        {v.last && (
          <g>
            <line
              x1={v.last.x + v.barW / 2}
              x2={v.last.x + v.barW / 2}
              y1={padT}
              y2={H - padB}
              stroke="var(--sol)"
              stroke-width="1"
              stroke-dasharray="2 4"
              opacity="0.6"
            />
            <circle cx={v.last.x + v.barW / 2} cy={v.last.y - 6} r="3.4" style="fill:var(--sol)" />
          </g>
        )}

        {v.yearLabels.map(({ d, i }) => (
          <text
            x={padL + i * v.stepW + v.barW / 2}
            y={H - 12}
            text-anchor="middle"
            fill="#7d94a8"
            font-size="12"
            font-family={monoFont}
          >
            {d.year}
          </text>
        ))}
      </svg>
    ))
  }

  <div class="legend">
    <span><i style="background:var(--nino)"></i> El Niño · sobre +0,5°</span>
    <span><i style="background:var(--neutral)"></i> Neutral · entre −0,5° y +0,5°</span>
    <span><i style="background:var(--nina)"></i> La Niña · bajo −0,5°</span>
    <span><i style="background:var(--sol)"></i> Último dato publicado</span>
  </div>
</div>

<script>
  const charts = document.querySelectorAll<HTMLElement>("[data-oni-chart]");
  for (const wrap of charts) {
    const readoutText = wrap.querySelector<HTMLElement>("[data-chart-readout-text]");
    const defaultText = wrap.dataset.defaultReadout ?? "";

    const bindSvg = (svg: SVGSVGElement) => {
      const bars = Array.from(svg.querySelectorAll<SVGRectElement>(".chart-bar"));
      if (!bars.length || !readoutText) return;

      const handlePointer = (e: PointerEvent) => {
        const rect = svg.getBoundingClientRect();
        if (!rect.width) return;
        const relX = ((e.clientX - rect.left) / rect.width) * 1000;
        const plotL = 52;
        const plotW = 1000 - 52 - 18;
        const idx = Math.min(
          bars.length - 1,
          Math.max(0, Math.floor(((relX - plotL) / plotW) * bars.length)),
        );
        const target = bars[idx];
        if (target?.dataset.summary) {
          readoutText.textContent = target.dataset.summary;
        }
      };

      svg.addEventListener("pointermove", handlePointer);
      svg.addEventListener("pointerdown", handlePointer);
      svg.addEventListener("pointerleave", () => {
        readoutText.textContent = defaultText;
      });
    };

    for (const svg of wrap.querySelectorAll<SVGSVGElement>("svg.chart-svg")) {
      bindSvg(svg);
    }

    const buttons = wrap.querySelectorAll<HTMLButtonElement>("[data-range-btn]");
    const panels = wrap.querySelectorAll<SVGSVGElement>("[data-range-panel]");
    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        const key = btn.dataset.rangeBtn;
        for (const b of buttons) {
          const active = b === btn;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-selected", String(active));
        }
        for (const p of panels) {
          p.classList.toggle("is-hidden", p.dataset.rangePanel !== key);
        }
      });
    }
  }
</script>
