---
import { nav, sources, site } from "../data/content";
import Sun from "./Sun.astro";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="brand" aria-label={`${site.name} — inicio`}>
          <Sun size={22} />
          <span>El Niño Argentina<small>Monitoreo ENSO</small></span>
        </a>
        <p style="margin-top:14px;max-width:34ch;">
          Portal independiente de seguimiento del fenómeno de El Niño y La Niña en Argentina.
          Datos abiertos de organismos oficiales.
        </p>
      </div>
      <div>
        <h4>Secciones</h4>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/glosario/">Glosario</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <div>
        <h4>Fuentes de datos</h4>
        <ul>
          {sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Legal</h4>
        <ul>
          <li><a href="/acerca/">Acerca del sitio</a></li>
          <li><a href="/privacidad/">Privacidad</a></li>
          <li><a href="/cookies/">Cookies</a></li>
          <li><a href="/terminos/">Términos de uso</a></li>
          <li><a href="/seguridad/">Seguridad</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.name}. Todos los derechos reservados.</span>
      <span>Datos: NOAA · IRI · SMN · BOM. Sitio con fines informativos.</span>
    </div>
  </div>
</footer>
