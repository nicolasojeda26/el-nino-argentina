---
interface Props {
  value: number;
  min?: number;
  max?: number;
  caption?: string;
}

const { value, min = -3, max = 3, caption } = Astro.props;
const pct = Math.min(100, Math.max(0, ((value - min) / (max - min)) * 100));
---

<div class="gauge">
  <div
    class="gauge-bar"
    role="meter"
    aria-valuenow={value}
    aria-valuemin={min}
    aria-valuemax={max}
    aria-label="Posición del índice ONI en la escala ENSO"
  >
    <span class="gauge-marker" style={`left:${pct}%`}></span>
  </div>
  <div class="gauge-labels">
    <span>La Niña</span>
    <span>Neutral</span>
    <span>El Niño</span>
  </div>
  {caption && <p class="gauge-caption">{caption}</p>}
</div>
