---
/**
 * Aviso de consentimiento para la medición de audiencia (Google Analytics 4).
 * Consent Mode v2: `analytics_storage` arranca en "denied" (ver Layout.astro) y
 * solo pasa a "granted" si el visitante acepta. La elección se guarda en
 * localStorage ("enso-consent-analytics"). No afecta la configuración de AdSense.
 */
---

<div
  class="consent"
  id="consentBanner"
  role="dialog"
  aria-live="polite"
  aria-labelledby="consentTitle"
  aria-describedby="consentText"
  hidden
>
  <div class="consent-inner">
    <div class="consent-copy">
      <p class="consent-title" id="consentTitle">Medición de audiencia</p>
      <p class="consent-text" id="consentText">
        Usamos Google Analytics para contar visitas de forma agregada y mejorar el sitio. Solo
        instala cookies si lo aceptás. <a href="/cookies/">Más información</a>
      </p>
    </div>
    <div class="consent-actions">
      <button type="button" class="btn btn-ghost" data-consent="denied">Rechazar</button>
      <button type="button" class="btn btn-primary" data-consent="granted">Aceptar analíticas</button>
    </div>
  </div>
</div>

<script>
  const KEY = "enso-consent-analytics";
  const banner = document.getElementById("consentBanner");

  type Choice = "granted" | "denied";

  function read(): Choice | null {
    try {
      const v = localStorage.getItem(KEY);
      return v === "granted" || v === "denied" ? v : null;
    } catch {
      return null;
    }
  }

  function clearGaCookies() {
    const host = location.hostname;
    const domains = ["", host, `.${host}`, `.${host.split(".").slice(-3).join(".")}`];
    document.cookie
      .split(";")
      .map((c) => c.split("=")[0].trim())
      .filter((name) => name === "_ga" || name.startsWith("_ga_"))
      .forEach((name) => {
        domains.forEach((d) => {
          document.cookie = `${name}=; Max-Age=0; path=/${d ? `; domain=${d}` : ""}`;
        });
      });
  }

  function apply(choice: Choice) {
    try {
      localStorage.setItem(KEY, choice);
    } catch {}
    const w = window as unknown as { gtag?: (...args: unknown[]) => void };
    w.gtag?.("consent", "update", { analytics_storage: choice });
    if (choice === "denied") clearGaCookies();
    if (banner) banner.hidden = true;
  }

  function open(focus = false) {
    if (!banner) return;
    banner.hidden = false;
    if (focus) banner.querySelector<HTMLButtonElement>('[data-consent="granted"]')?.focus();
  }

  banner?.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((btn) => {
    btn.addEventListener("click", () => apply(btn.dataset.consent as Choice));
  });

  document.querySelectorAll<HTMLElement>("[data-consent-open]").forEach((el) => {
    el.hidden = false;
    el.closest("li")?.removeAttribute("hidden");
    el.addEventListener("click", (e) => {
      e.preventDefault();
      open(true);
    });
  });

  if (!read()) open();
</script>

<style>
.consent {
  position: fixed;
  left: 16px;
  right: 16px;
  bottom: 16px;
  z-index: 120;
  max-width: 760px;
  margin: 0 auto;
  background: var(--paper);
  color: var(--text);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  box-shadow: 0 18px 40px -18px rgba(10, 27, 45, 0.45);
}

.consent[hidden] {
  display: none;
}

.consent-inner {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 18px 20px;
}

.consent-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.consent-title {
  margin: 0 0 4px;
  font-family: var(--mono);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}

.consent-text {
  margin: 0;
  font-size: 0.92rem;
  line-height: 1.5;
  color: var(--text-soft);
}

.consent-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 10px;
}

.consent-actions .btn {
  padding: 11px 16px;
  white-space: nowrap;
}

@media (max-width: 640px) {
  .consent {
    left: 12px;
    right: 12px;
    bottom: 12px;
  }

  .consent-inner {
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    padding: 16px;
  }

  .consent-actions .btn {
    flex: 1 1 0;
    justify-content: center;
  }
}

@media print {
  .consent {
    display: none !important;
  }
}
</style>
