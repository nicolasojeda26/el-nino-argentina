---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { site } from "../../data/content";

export async function getStaticPaths() {
  const posts = (await getCollection("noticias", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post) => {
    const related = posts
      .filter((p) => p.id !== post.id)
      .sort((a, b) => {
        const sameTagA = a.data.tag === post.data.tag ? 1 : 0;
        const sameTagB = b.data.tag === post.data.tag ? 1 : 0;
        return sameTagB - sameTagA || b.data.date.valueOf() - a.data.date.valueOf();
      })
      .slice(0, 3);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("es-AR", { day: "numeric", month: "long", year: "numeric" }).format(d);

const origin = Astro.site ?? site.url;
const url = new URL(Astro.url.pathname, origin).href;
const shareText = encodeURIComponent(`${post.data.title} — ${url}`);
const shareTweet = `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(url)}`;
const shareWa = `https://wa.me/?text=${shareText}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { "@type": "Organization", name: post.data.author },
  publisher: {
    "@type": "Organization",
    name: site.name,
    logo: { "@type": "ImageObject", url: new URL("/apple-touch-icon.png", origin).href },
  },
  inLanguage: "es-AR",
  url,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  image: [new URL("/og.png", origin).href],
  articleSection: post.data.tag,
};
---

<Layout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  type="article"
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Inicio", path: "/" },
    { name: "Notas", path: "/noticias/" },
    { name: post.data.title, path: `/noticias/${post.id}/` },
  ]}
>
  <div class="container breadcrumbs">
    <a href="/">Inicio</a> · <a href="/noticias/">Notas</a> · {post.data.tag}
  </div>

  <article class="section container prose">
    <span class="tag">{post.data.tag}</span>
    <h1 style="margin-top:14px;">{post.data.title}</h1>
    <div class="post-meta" style="margin-bottom:28px;">
      <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      <span> · {post.data.author}</span>
    </div>

    <Content />

    <div class="share-bar" aria-label="Compartir nota">
      <span class="share-label">Compartir:</span>
      <a class="share-btn" href={shareWa} target="_blank" rel="noopener">
        WhatsApp
      </a>
      <a class="share-btn" href={shareTweet} target="_blank" rel="noopener">
        X / Twitter
      </a>
      <button type="button" class="share-btn" id="copyLinkBtn" data-url={url}>
        Copiar enlace
      </button>
    </div>

    <AdSlot label="Publicidad" slot="noticia" />

    <div class="hero-cta" style="margin-top:36px;">
      <a class="btn btn-ghost" href="/noticias/">← Volver a las notas</a>
      <a class="btn btn-primary" href="/pronostico/">Ver pronóstico actual</a>
    </div>
    <p style="margin-top:20px;font-size:0.95rem;">
      ¿Te quedó alguna duda sobre El Niño o La Niña? Revisá las{" "}
      <a href="/preguntas/">preguntas frecuentes</a> o el <a href="/glosario/">glosario</a>.
    </p>
  </article>

  {
    related.length > 0 && (
      <section class="section container">
        <p class="eyebrow">Seguí leyendo</p>
        <h2>Notas relacionadas</h2>
        <div class="grid grid-3" style="margin-top:24px;">
          {related.map((p) => (
            <a class="card post-card" href={`/noticias/${p.id}/`}>
              <span class="tag">{p.data.tag}</span>
              <h3>{p.data.title}</h3>
              <p style="font-size:0.92rem;">{p.data.description}</p>
              <div class="post-meta">
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Layout>

<script>
  const copyBtn = document.getElementById("copyLinkBtn") as HTMLButtonElement | null;
  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.dataset.url ?? window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      const original = copyBtn.textContent;
      copyBtn.textContent = "¡Enlace copiado!";
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    } catch {
      // Fallback silencioso
    }
  });
</script>
